# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role key (SECRET - kabhi frontend ya GitHub par mat daalna)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Admin panel ka password
ADMIN_PASSWORD=apna-strong-password
# Koi bhi lamba random text (login cookie sign karne ke liye)
SESSION_SECRET=koi-lamba-random-text
# Optional: storage bucket ka naam (default: screenshots)
# SUPABASE_BUCKET=screenshots
